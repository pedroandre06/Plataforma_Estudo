{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tools/**,.kilo/**,**/__pycache__/**,**/*.pyc,data/*.db,data/*.db-shm,data/*.db-wal,data/.secret_key,*.log,tmp_*}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
