# =====================================================================
#  Variaveis de ambiente da Plataforma de Estudos
#  Copie para .env (ou cole direto no painel do Vercel).
#  Nada aqui e obrigatorio no uso local: sem DATABASE_URL o app usa SQLite.
# =====================================================================

# Chave das sessoes (obrigatoria na nuvem: no Vercel o disco e somente leitura).
# Gere uma com: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Banco hospedado (Postgres). Se preenchida, o app deixa de usar o SQLite local.
# No Vercel, o Neon (Marketplace) injeta DATABASE_URL / POSTGRES_URL sozinho.
# Exemplo local com Docker:
#   docker run -d --name pg-plataforma -e POSTGRES_PASSWORD=postgres \
#       -e POSTGRES_DB=plataforma -p 55432:5432 postgres:16-alpine
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/plataforma
POSTGRES_URL=

# Registro publico de novos usuarios: 0 fecha (recomendado na nuvem), 1 abre.
PERMITIR_REGISTRO=1

# Limite de upload do import de questoes (MB). O Vercel aceita ~4,5 MB por requisicao.
MAX_UPLOAD_MB=8

# Pasta com os PDFs das disciplinas (uso local, opcional).
DOCS_DIR=
